{
  "name": "sumitgundawar-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:feed && npm run gen:jsonld && npm run gen:articles && npm run gen:learn && tsc && npm run check:worker && npm run check:prose && npm run check:content && npm run check:contrast && vite build && npm run prerender",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "routes": "node scripts/route-check.mjs",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name sumitgundawar --branch main",
    "gen:topics": "npx tsx scripts/gen-worker-topics.mjs",
    "gen:feed": "npx tsx scripts/gen-feed.mjs",
    "check:worker": "cd worker && npx tsc --noEmit && cd .. && node scripts/worker-check.mjs",
    "check:prose": "node scripts/prose-check.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:prod": "node scripts/prod-check.mjs",
    "gen:jsonld": "npx tsx scripts/gen-jsonld.mjs",
    "check:security": "node scripts/security-check.mjs",
    "check:newsletter": "npx esbuild worker/src/newsletter.ts --bundle --format=esm --platform=neutral --outfile=/tmp/nl.mjs && node scripts/newsletter-test.mjs /tmp/nl.mjs",
    "prerender": "node scripts/prerender.mjs",
    "check:robots": "node scripts/robots-check.mjs",
    "gen:articles": "npx tsx scripts/gen-worker-articles.mjs",
    "check:email": "npx esbuild worker/src/email.ts --bundle --format=esm --platform=neutral --outfile=/tmp/em.mjs && node scripts/email-compat.mjs /tmp/em.mjs",
    "check:content": "npx tsx scripts/content-check.mjs",
    "gen:learn": "npx tsx scripts/gen-learn-manifest.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/commit-mono": "^5.2.5",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.9.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.3.0"
  }
}
