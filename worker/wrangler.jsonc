{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-agent-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // Non-secret identifiers only. This repo is public — SLACK_SIGNING_SECRET and
  // GITHUB_TOKEN must never appear here; set them with `wrangler secret put`.
  "vars": {
    "GITHUB_REPO": "sumitgundawar/sumitgundawar.github.io",
    "SLACK_CHANNEL_ID": "C0BPGE51GTX",
    "SLACK_ALLOWED_USER_ID": "U0BPJ0ULVDL",
    "SITE_ORIGIN": "https://sumitgundawar.com",
    "SUPABASE_URL": "https://jkshqtamzuzmpqftnqhv.supabase.co"
  },

  // Weekly analytics digest to Slack. Monday morning, UTC.
  // Rate limiting state. The in-memory limiter it replaces lived in one
  // isolate, and Workers run many, so a caller simply hit a fresh counter on
  // the next request and the limit did close to nothing.
  "kv_namespaces": [{ "binding": "RATE", "id": "ecd045716a8141de8ce9a5c6038cecbd" }],

  "triggers": { "crons": ["0 9 * * 1"] }
}