# There is deliberately no /assets/* rule here. Asset caching is set by
# functions/assets/[[path]].ts instead, and it has to be, because _headers
# matches on the request PATH: a hit and a miss for a hashed asset share one, so
# there is no way to give them different caching here. The rule that used to
# live here applied max-age=31536000, immutable to the SPA fallback as well as
# to real assets, which cached index.html under a bundle URL for a year and
# rendered the site blank. A Function sees the RESPONSE and can tell the two
# apart.

# HTML must not be cached hard, or a deploy takes a day to reach anyone.
# stale-while-revalidate serves the old copy instantly and refreshes behind it.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # http already 301s to https, but a redirect is one round trip that an
  # attacker on the network gets to see and can intercept. HSTS removes that
  # first request entirely for anyone who has visited before.
  #
  # Six months, and deliberately without includeSubDomains or preload. Both are
  # effectively irreversible: includeSubDomains would break any subdomain that
  # is not already https, and the DNS records cannot be enumerated from here to
  # prove none exists. preload is harder still to undo, and belongs to a
  # decision made once rather than to a header added in passing.
  Strict-Transport-Security: max-age=15552000
