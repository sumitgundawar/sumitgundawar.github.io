# NOTE: there is deliberately no /assets/* rule here any more. See below.
#
# It used to say max-age=31536000, immutable, which is right for a hashed file
# and catastrophic for a miss. _headers matches on the REQUEST PATH, so when
# Pages answers a request for an asset it does not have by serving the SPA
# fallback, that HTML inherited the same one-year immutable header. One request
# in the seconds after a deploy, before the edge had the new bundle, cached
# index.html under the new bundle's URL for a year. The browser then refuses
# text/html as a module script and the entire site renders blank for everyone on
# that colo, with no way out but a purge.
#
# Measured, not assumed: a request for /assets/definitely-missing-xyz.js at the
# Pages origin returned 200, content-type text/html, and
# cache-control: public, max-age=31536000, immutable.
#
# Pages already sets immutable caching on real hashed assets by itself, keyed on
# the asset rather than on the path, which is the distinction that matters.

# Media in public/ keeps the filename it was written with, so it cannot be
# immutable: a replaced photo under the same name has to be able to reach
# people. A day fresh, then served stale while it revalidates behind the
# request, which costs a returning visitor nothing and still propagates a swap
# within the week. Rename the file when a change has to land immediately.
/robot/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/podcast/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML must not be cached hard, or a deploy takes a day to reach anyone.
# stale-while-revalidate serves the old copy instantly and refreshes behind it.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # http already 301s to https, but a redirect is one round trip that an
  # attacker on the network gets to see and can intercept. HSTS removes that
  # first request entirely for anyone who has visited before.
  #
  # Six months, and deliberately without includeSubDomains or preload. Both are
  # effectively irreversible: includeSubDomains would break any subdomain that
  # is not already https, and the DNS records cannot be enumerated from here to
  # prove none exists. preload is harder still to undo, and belongs to a
  # decision made once rather than to a header added in passing.
  Strict-Transport-Security: max-age=15552000
